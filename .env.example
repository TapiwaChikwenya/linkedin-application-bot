# Copy to .env and fill locally. Never commit .env.
FIREFOX_PROFILE_PATH=C:\\Users\\you\\AppData\\Roaming\\Mozilla\\Firefox\\Profiles\\your-profile

# Required when using Chrome, or when Firefox is not already logged in:
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

LINKEDIN_PHONE_NUMBER=
LINKEDIN_APPLICATION_CITY=
LINKEDIN_BOT_PRO_PASSWORD=

# Human pacing. Keep "human" on a real account. Use "fast" only for local tests.
LINKEDIN_PACE=human
LINKEDIN_MAX_APPLICATIONS_PER_RUN=12
LINKEDIN_MAX_APPLICATIONS_PER_DAY=25

# Optional. Absolute path to the resume uploaded into Easy Apply file inputs.
LINKEDIN_RESUME_PATH=
LINKEDIN_PROFILE_URL=
APPLICANT_FIRST_NAME=
APPLICANT_LAST_NAME=

# Local Llama sidecar (Ollama). auto = use it when http://127.0.0.1:11434 is up.
LINKEDIN_LLM=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Skip listings when local Llama fit is below this (0-1). Default 0.55.
LINKEDIN_JOB_FIT_THRESHOLD=0.55
# Optional extra facts for free-text questions. Leave empty rather than guessing.
LINKEDIN_APPLICANT_SUMMARY=

